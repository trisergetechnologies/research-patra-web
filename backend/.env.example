NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/research_patra

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Refresh cookie. Use "none" when the frontend and API are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (Dashboard > API Keys). Uploads return 503 until these are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=research-patra

# Blog cache refresh after publishing. Must match REVALIDATE_SECRET in blog-web/.env.production
BLOG_REVALIDATE_URL=http://127.0.0.1:3001/blog/api/revalidate
REVALIDATE_SECRET=

# Email for sign-in codes (Gmail: SMTP_USER = the address, SMTP_PASS = a 16-char App Password).
# Without these, development prints codes to the console and production refuses to send.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Research Patra <researchpatra@gmail.com>"

# Used by `npm run seed:users` and `npm run seed:blog`. Both accounts sign in with email codes.
SEED_ADMIN_NAME=Research Patra
SEED_ADMIN_EMAIL=researchpatra@gmail.com
SEED_STAFF_NAME=Vaibhav Pandey
SEED_STAFF_EMAIL=vaibhavkpandey13@gmail.com
