{
  "name": "research-patra-backend",
  "version": "1.0.0",
  "description": "Research Patra CMS API",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --watch .env --exec \"node --use-system-ca src/server.js\"",
    "start": "node src/server.js",
    "seed:blog": "node src/scripts/seedBlog.js",
    "seed:users": "node src/scripts/seedUsers.js",
    "sync:indexes": "node src/scripts/syncIndexes.js"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
